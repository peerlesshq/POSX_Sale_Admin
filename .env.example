# =============================================================================
# POSX Token Sale System — .env.example
# -----------------------------------------------------------------------------
# This file documents every environment variable the backend/workers and
# frontend builds require. Copy this to `.env.local` (or environment-specific
# equivalents) and fill in real values.
#
# Sources of truth:
#   - 02_Backend_Architecture_Spec.md §27
#   - 14_Deployment_And_Env_Spec.md §7 (full list)
#
# IMPORTANT:
#   - `SUPABASE_SERVICE_ROLE_KEY` and all `*_SESSION_SECRET` values MUST NEVER
#     be exposed to frontend bundles.
#   - `VITE_*` variables ARE exposed to frontend bundles. Do NOT put secrets
#     there.
#   - In staging and production, session secrets must be strong random values.
# =============================================================================

# --- Core app ---
APP_ENV=local
APP_NAME=POSX Token Sale System
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
DEFAULT_TIMEZONE=UTC
LOG_LEVEL=debug

# --- User frontend (public) ---
VITE_APP_ENV=local
VITE_APP_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:54321/functions/v1/api/v1
VITE_SUPPORTED_LOCALES=zh-CN,zh-TW,en,ko
VITE_DEFAULT_LOCALE=zh-CN

# --- Admin frontend (public) ---
VITE_ADMIN_APP_ENV=local
VITE_ADMIN_BASE_URL=http://localhost:3001
VITE_ADMIN_API_BASE_URL=http://localhost:54321/functions/v1/api/v1
VITE_ADMIN_DEFAULT_LOCALE=en

# --- Supabase (backend-only) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_me_service_role_key_placeholder
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase (safe public) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace_me_public_anon_placeholder

# --- Auth / session ---
USER_SESSION_SECRET=replace_with_long_random_secret_min_16_chars
ADMIN_SESSION_SECRET=replace_with_long_random_secret_min_16_chars_different
USER_SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=168
NONCE_TTL_MINUTES=5

# --- Chain / RPC ---
CHAIN_ID=1
RPC_URL=https://example-rpc-url.invalid
CONTRACT_ADDRESS_MAIN=0x0000000000000000000000000000000000000001
MIN_CONFIRMATIONS=12
CHAIN_SYNC_BATCH_SIZE=500
CHAIN_REORG_SAFETY_WINDOW=20

# --- Job / scheduler flags ---
ENABLE_CHAIN_SYNC_JOB=false
ENABLE_SETTLEMENT_JOB=false
ENABLE_SUMMARY_REBUILD_JOB=false
ENABLE_EXPORT_JOB=false
ENABLE_CLEANUP_JOB=false
CHAIN_SYNC_INTERVAL_SECONDS=60
SETTLEMENT_RUN_HOUR_UTC=0
SETTLEMENT_RUN_MINUTE_UTC=10
SUMMARY_REBUILD_INTERVAL_MINUTES=60
EXPORT_POLL_INTERVAL_SECONDS=30

# --- Claim / purchase bootstrap defaults ---
# NOTE: These are runtime fallbacks only. The business source of truth for
# claim / purchase constants is the Config Center (see 09_Config_Center_Spec.md
# §18.3 and 14_Deployment_And_Env_Spec.md §7.8). Business logic must resolve
# values through ConfigResolverService, not from these env variables.
MIN_CLAIM_AMOUNT_DEFAULT=10
CLAIM_PENDING_SIGNATURE_TTL_MINUTES=30
CLAIM_MAX_RETRY_COUNT=3
MIN_PURCHASE_AMOUNT_DEFAULT=1000
PURCHASE_ORDER_EXPIRY_MINUTES=60

# --- Reporting / export ---
EXPORT_STORAGE_PATH=/tmp/posx_exports
EXPORT_RETENTION_DAYS=7
REPORT_MAX_EXPORT_ROWS=100000

# --- Observability / debug ---
ENABLE_REQUEST_LOGGING=true
ENABLE_SQL_DEBUG=false
ENABLE_JOB_DEBUG=true
