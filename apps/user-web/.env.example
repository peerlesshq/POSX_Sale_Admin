# user-web environment variables
#
# Copy to `.env.local` for local dev. Production builds must NOT
# set any VITE_USE_MOCK_API or VITE_ENABLE_DEV_AUTH_BYPASS values
# to `true` — the env loader additionally hard-disables them when
# VITE_APP_ENV=production regardless of the raw value, but not
# shipping them at all is the cleanest guarantee.

# Which environment this build represents. Controls the hard-disable
# of dev affordances. Allowed: local | staging | production
VITE_APP_ENV=local

# Backend base URL. In local dev, this is the Supabase edge-functions
# dev server.
VITE_API_BASE_URL=http://localhost:54321/functions/v1/api/v1

# Default UI locale. Allowed: zh-CN | zh-TW | en | ko
VITE_DEFAULT_LOCALE=zh-CN

# Locales that appear in the language picker, comma-separated.
VITE_SUPPORTED_LOCALES=zh-CN,zh-TW,en,ko

# ---- Dev-only toggles (hard-disabled in production) -------------

# When true, the app uses the in-memory mock API client instead of
# hitting the backend. No fetch calls go out. Pair with dev auth
# bypass to get a fully offline demo.
VITE_USE_MOCK_API=false

# When true, the login screen shows the dev persona picker and
# wallet-signature flow is bypassed. The session token synthesised
# by this flow has a `dev-` prefix — the real backend will reject
# it, so don't use this against a real API unless you also set
# VITE_USE_MOCK_API=true.
VITE_ENABLE_DEV_AUTH_BYPASS=false
