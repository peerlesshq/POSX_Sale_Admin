VITE_APP_ENV=local
VITE_APP_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:54321/functions/v1/api/v1
VITE_SUPPORTED_LOCALES=zh-CN,zh-TW,en,ko
VITE_DEFAULT_LOCALE=zh-CN

# ---- Dev-only toggles (hard-disabled in production by env.ts) ----
# Enable the persona picker so you can log in without a browser wallet extension.
VITE_ENABLE_DEV_AUTH_BYPASS=true
# Use the in-memory mock API so the dev-* session token is accepted offline.
VITE_USE_MOCK_API=true
