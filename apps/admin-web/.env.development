VITE_ADMIN_APP_ENV=local
VITE_ADMIN_BASE_URL=http://localhost:3001
VITE_ADMIN_API_BASE_URL=http://localhost:54321/functions/v1/api/v1
VITE_ADMIN_DEFAULT_LOCALE=en

# Dev affordances — these ONLY apply when VITE_ADMIN_APP_ENV=local.
# The env loader hard-disables them on staging / production.
VITE_USE_MOCK_API=true
VITE_ENABLE_ADMIN_DEV_LOGIN=true
# Turn on the hardcoded fallback credential list for zero-config local dev.
# Staging / production MUST set this to false (it's force-false in non-local anyway).
VITE_ENABLE_ADMIN_DEV_LOGIN_LOCAL_FALLBACK=true
