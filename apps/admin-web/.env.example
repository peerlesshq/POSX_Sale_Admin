# admin-web environment variables
#
# Copy to `.env.local` for local dev. Production builds must NOT
# set any VITE_USE_MOCK_API or VITE_ENABLE_ADMIN_DEV_LOGIN values
# to `true` — the env loader additionally hard-disables them when
# VITE_ADMIN_APP_ENV=production regardless of the raw value.

# Which environment this build represents. Allowed: local | staging | production
VITE_ADMIN_APP_ENV=local

# Backend base URL for admin endpoints.
VITE_ADMIN_API_BASE_URL=http://localhost:54321/functions/v1/api/v1

# ---- Dev-only toggles (hard-disabled in production) -------------

# When true, the app uses the in-memory mock admin API instead of
# hitting the backend.
VITE_USE_MOCK_API=false

# When true, the login page renders one-click "Sign in as..."
# buttons for the seeded test admin accounts. The buttons call the
# REAL login endpoint with the seeded credentials, so the accounts
# must exist in the DB (run `pnpm db:seed` first).
VITE_ENABLE_ADMIN_DEV_LOGIN=false

# Dev login credentials — JSON array. Overrides the local fallback.
# Set this in `.env.local` (gitignored) with your seeded accounts:
#
# VITE_ADMIN_DEV_CREDENTIALS='[{"labelKey":"auth.dev_login_as_super","email":"superadmin@posx.local","password":"posx-local-super-admin-12","role":"super_admin"}]'
#
# Leave empty if you want the login page to show an integration-required
# hint instead of auto-wiring credentials.
VITE_ADMIN_DEV_CREDENTIALS=

# When true AND VITE_ADMIN_APP_ENV=local AND VITE_ADMIN_DEV_CREDENTIALS
# is empty, the login page falls back to a hardcoded set of seeded
# local credentials. ALWAYS false in staging / production regardless
# of this flag. This exists solely so a fresh `git clone` works out
# of the box — it is NOT how you ship dev creds to staging.
VITE_ENABLE_ADMIN_DEV_LOGIN_LOCAL_FALLBACK=false
