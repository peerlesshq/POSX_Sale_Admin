# POSX Token Sale — Staging Environment
# Copy to .env.staging and fill in real values from the Supabase staging project

APP_ENV=staging
APP_NAME=POSX Token Sale (Staging)
APP_BASE_URL=https://app-staging.example.com
ADMIN_BASE_URL=https://admin-staging.example.com

# Supabase staging project
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres.YOUR_STAGING_PROJECT:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Session secrets (generate unique values — DO NOT reuse production)
USER_SESSION_SECRET=staging_user_secret_min_16_chars
ADMIN_SESSION_SECRET=staging_admin_secret_min_16_chars

# Chain config — use testnet or dummy values for staging
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
CONTRACT_ADDRESS_MAIN=0x0000000000000000000000000000000000000000

# Jobs — mostly disabled for staging, enable selectively
ENABLE_CHAIN_SYNC_JOB=false
ENABLE_SETTLEMENT_JOB=false
ENABLE_SUMMARY_REBUILD_JOB=true
ENABLE_EXPORT_JOB=true
ENABLE_CLEANUP_JOB=false

# Logging
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_SQL_DEBUG=false
