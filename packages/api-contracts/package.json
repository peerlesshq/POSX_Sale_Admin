{
  "name": "@posx/api-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas for the POSX API envelope, pagination, and common primitive types. Endpoint-specific schemas added in Phase 4.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./endpoints": {
      "types": "./src/endpoints/index.ts",
      "import": "./src/endpoints/index.ts",
      "default": "./src/endpoints/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@posx/shared-types": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
