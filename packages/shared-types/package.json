{
  "name": "@posx/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript types: enums, primitives, domain interfaces, holding service contract.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./enums": {
      "types": "./src/enums/index.ts",
      "import": "./src/enums/index.ts",
      "default": "./src/enums/index.ts"
    },
    "./domain": {
      "types": "./src/domain/index.ts",
      "import": "./src/domain/index.ts",
      "default": "./src/domain/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
