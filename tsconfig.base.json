{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "useUnknownInCatchVariables": true,
    "baseUrl": ".",
    "paths": {
      "@posx/shared-types": ["./packages/shared-types/src/index.ts"],
      "@posx/shared-types/*": ["./packages/shared-types/src/*"],
      "@posx/shared-utils": ["./packages/shared-utils/src/index.ts"],
      "@posx/shared-utils/*": ["./packages/shared-utils/src/*"],
      "@posx/api-contracts": ["./packages/api-contracts/src/index.ts"],
      "@posx/api-contracts/*": ["./packages/api-contracts/src/*"],
      "@posx/config": ["./packages/config/src/index.ts"],
      "@posx/config/*": ["./packages/config/src/*"],
      "@posx/domain-rules": ["./packages/domain-rules/src/index.ts"],
      "@posx/domain-rules/*": ["./packages/domain-rules/src/*"],
      "@posx/test-utils": ["./packages/test-utils/src/index.ts"],
      "@posx/test-utils/*": ["./packages/test-utils/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage"]
}
